# Copy to .env for Docker Compose: cp .env.example .env
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
DATABASE_URL=postgres://tickets:tickets@localhost:5432/tickets

# Replace this with a unique secret for any deployed environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver

JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=1
JWT_REFRESH_COOKIE_NAME=ticket_desk_refresh

# Docker Compose routes to the API service by its container name.
API_PROXY_TARGET=http://api:8000
